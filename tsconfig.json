{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "allowJs": true,
        "checkJs": true,
        "jsx": "preserve",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "skipLibCheck": true,
        "noEmit": true,
        "allowSyntheticDefaultImports": true,
        "strict": false,
        "typeRoots": [
            "./types",
            "./node_modules/@types"
        ]
    },
    "include": [
        "*.js",
        "**/*.js",
        "./types/**/*.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}